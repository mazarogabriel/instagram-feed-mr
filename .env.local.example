# Create an internal integration in Notion and store its token only in Vercel.
# Never commit a real token to this file or to GitHub.
NOTION_TOKEN=ntn_replace_with_your_secret_token

# Data source used by the Instagram MR view in the Studio workspace.
NOTION_DATA_SOURCE_ID=c394a082-c32a-8389-8345-077f489e674f

# MR page used by the Empresa relation filter.
NOTION_COMPANY_PAGE_ID=c444a082-c32a-8350-adfc-0110adbf4fa7

# Profile displayed above the grid.
NEXT_PUBLIC_PROFILE_USERNAME=mr.melinaromano
NEXT_PUBLIC_PROFILE_DISPLAY_NAME=Melina Romano Studio
NEXT_PUBLIC_PROFILE_BIO=Arquitetura, interiores, design e arte.
NEXT_PUBLIC_PROFILE_WEBSITE=
NEXT_PUBLIC_PROFILE_AVATAR_URL=
NEXT_PUBLIC_HIGHLIGHTS=[]
